<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores allowBackup="false" for a phone-to-phone transfer (audit of 26 Oct): without these rules the
     home-server key and the parent-PIN hash would travel to the new phone. Nothing leaves, either way;
     the home server's "Restore my settings" brings the settings back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
