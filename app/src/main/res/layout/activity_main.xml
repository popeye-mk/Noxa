<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls when the content is taller than the screen (small phones, TVs). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_main">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/off"
        android:textColor="#8FA0BC"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="44dp" />

    <Switch
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:thumbTint="@color/switch_thumb"
        android:trackTint="@color/switch_track"
        android:layout_marginBottom="52dp" />

    <TextView
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blocked_count"
        android:textColor="#4CC38A"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="19sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/week_title"
        android:textColor="#8FA0BC"
        android:textSize="12sp" />

    <com.guardian.app.WeekChartView
        android:id="@+id/week"
        android:layout_width="280dp"
        android:layout_height="96dp"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/per_app_details"
        android:background="@drawable/btn_primary"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/watch_live"
        android:background="@drawable/btn_secondary"
        android:textColor="#FFFFFF" />

</LinearLayout>

</ScrollView>
