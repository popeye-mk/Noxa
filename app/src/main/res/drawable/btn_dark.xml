<?xml version="1.0" encoding="utf-8"?>
<!-- Standard button — a card lifted above the slate background, with a clear
     violet focus ring for TV/D-pad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="6dp" android:bottom="6dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#4A5A85" />
                    <stroke android:width="3dp" android:color="#8C6CFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="6dp" android:bottom="6dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#3C496D" />
                    <stroke android:width="1dp" android:color="#4E5D85" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
