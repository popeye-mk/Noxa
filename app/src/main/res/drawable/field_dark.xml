<?xml version="1.0" encoding="utf-8"?>
<!-- Text input; lifted for the slate background, violet edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#2C3757" />
            <stroke android:width="2dp" android:color="#8C6CFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#28324F" />
            <stroke android:width="1dp" android:color="#47547A" />
        </shape>
    </item>
</selector>
