<?xml version="1.0" encoding="utf-8"?>
<!-- Quieter navigation button, lifted for the slate background, violet focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="5dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#3C4A72" />
                    <stroke android:width="3dp" android:color="#8C6CFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#313E60" />
                    <stroke android:width="1dp" android:color="#47547A" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
