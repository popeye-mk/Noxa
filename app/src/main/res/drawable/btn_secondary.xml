<?xml version="1.0" encoding="utf-8"?>
<!-- Quieter navigation button, with a visible focused state for TV/D-pad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="5dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#202C4C" />
                    <stroke android:width="3dp" android:color="#7C5CFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#141A2B" />
                    <stroke android:width="1dp" android:color="#232E48" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
