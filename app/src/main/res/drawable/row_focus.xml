<?xml version="1.0" encoding="utf-8"?>
<!-- List rows (apps, allowlist entries): invisible normally, glowing card when
     the TV remote / D-pad focus lands on them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#22304F" />
            <stroke android:width="2dp" android:color="#7C5CFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
