<?xml version="1.0" encoding="utf-8"?>
<!-- App rows: transparent normally, a lifted glowing card when the TV remote /
     D-pad focus lands on them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#3A4A70" />
            <stroke android:width="2dp" android:color="#8C6CFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
