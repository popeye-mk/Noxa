<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.2 keep-alive: lets Noxa ASK (one system dialog, user decides) to be
         excluded from battery optimization, so protection isn't silently killed.
         The legitimate use-case this permission exists for. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.2 keep-alive: restart protection automatically after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android TV support: TVs are among the most tracker-infested devices
         people own (ACR, ad platforms, telemetry in every streaming app) and
         almost nobody blocks any of it. Declaring these makes Noxa appear in
         the TV launcher; requiring neither keeps phones unaffected. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Android 11+ package visibility: lets the "exclude an app" picker list
         the user's launchable apps (names shown locally only — nothing leaves
         the device, as always). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Shows Noxa in the Android TV home screen launcher too. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 2 per-app dashboard (one tap deeper, not the default screen). -->
        <activity
            android:name=".AppsActivity"
            android:exported="false" />

        <!-- Tunnel (option 2) config screen — one tap deeper. -->
        <activity
            android:name=".TunnelActivity"
            android:exported="false" />

        <!-- User allowlist ("never block these") — one tap deeper. -->
        <activity
            android:name=".AllowlistActivity"
            android:exported="false" />

        <!-- v1.2 keep-alive watchdog: every ~15 min + after boot, restarts
             protection if an aggressive battery manager killed it and the user
             still wants it on. Runs entirely on-device. -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The local filter. BIND_VPN_SERVICE is what lets us inspect traffic
             on-device; nothing is sent to any server. -->
        <service
            android:name=".GuardianVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
